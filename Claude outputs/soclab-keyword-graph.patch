+.hero-graph{
+  position:relative;
+  display:flex;
+  flex-direction:column;
+  justify-content:flex-end;
+  padding:0;
+  background:
+    linear-gradient(180deg,#ffffff 0%,#f6f9fc 100%);
+}
+
+.hero-graph svg{
+  position:absolute;
+  inset:10px 10px 46px;
+  width:auto;
+  height:auto;
+}
+
+.keyword-links line{
+  stroke:#c6d9e9;
+  transition:stroke .18s ease,opacity .18s ease;
+}
+
+.keyword-links line.is-active{stroke:var(--copper);}
+
+.hero-graph svg.is-focused .keyword-links line{opacity:.35}
+.hero-graph svg.is-focused .keyword-links line.is-active{opacity:1}
+
+.keyword-node{cursor:default;outline:none}
+
+.keyword-node circle{
+  stroke:#fff;
+  stroke-width:1.6;
+  transition:opacity .18s ease;
+}
+
+.keyword-node text{
+  font-family:"IBM Plex Sans KR",var(--font-sans);
+  font-size:12px;
+  font-weight:500;
+  fill:var(--ink-soft);
+  paint-order:stroke;
+  stroke:#fff;
+  stroke-width:2.6px;
+  stroke-linejoin:round;
+  pointer-events:none;
+  transition:fill .18s ease,opacity .18s ease;
+}
+
+.hero-graph.is-compact .keyword-node text{font-size:15px}
+
+.keyword-node.is-dimmed{opacity:.28}
+.keyword-node.is-active text{fill:var(--copper);font-weight:600}
+.keyword-node:focus-visible circle{stroke:var(--copper);stroke-width:2.4}
+
+.hero-graph-caption{
+  position:relative;
+  z-index:1;
+  display:flex;
+  flex-direction:column;
+  gap:2px;
+  margin:0;
+  padding:0 16px 12px;
+  color:var(--copper);
+  font-size:12.5px;
+  font-weight:600;
+  letter-spacing:-.01em;
+}
+
+.hero-graph-caption small{
+  font-size:12px;
+  font-weight:400;
+  color:var(--ink-soft);
+}
+
