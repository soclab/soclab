index 5c45395..bd91379 100644
--- a/script.js
+++ b/script.js
@@ -2743,11 +2743,207 @@ async function initializeCourses() {
   }
 }
 
+/* ------------------------------------------------------------
+   연구 키워드 그래프 (히어로)
+   research-keywords.json의 노드/링크를 SVG 네트워크로 그립니다.
+   색은 단일 청색 계열의 순차 스케일이며, 진할수록 관련 논문이 많습니다.
+   ------------------------------------------------------------ */
+const KEYWORD_SVG_NS = "http://www.w3.org/2000/svg";
+const KEYWORD_RAMP = ["#6d97c1", "#5b88b2", "#4a7599", "#3a6389", "#2b4a67"];
+
+function keywordRampColor(count, maxCount) {
+  const ratio = maxCount > 0 ? Math.sqrt(count / maxCount) : 0;
+  const index = Math.min(
+    KEYWORD_RAMP.length - 1,
+    Math.floor(ratio * KEYWORD_RAMP.length)
+  );
+  return KEYWORD_RAMP[index];
+}
+
+function createSvgElement(name, attributes) {
+  const element = document.createElementNS(KEYWORD_SVG_NS, name);
+  Object.entries(attributes).forEach(([key, value]) => {
+    element.setAttribute(key, String(value));
+  });
+  return element;
+}
+
+const KEYWORD_COMPACT_WIDTH = 430;
+
+function renderKeywordGraph(container, graph) {
+  const width = Number(graph.meta?.width) || 480;
+  const height = Number(graph.meta?.height) || 360;
+  const allNodes = Array.isArray(graph.nodes) ? graph.nodes : [];
+
+  if (!allNodes.length) {
+    return;
+  }
+
+  // On narrow screens the labels would shrink below readable size, so the map
+  // keeps only the strongest keywords and draws them larger.
+  const compact = container.clientWidth < KEYWORD_COMPACT_WIDTH;
+  const nodes = (compact
+    ? allNodes.filter((node) => typeof node.cx === "number")
+    : allNodes
+  ).map((node) =>
+    compact
+      ? { ...node, x: node.cx, y: node.cy, r: node.cr }
+      : node
+  );
+  const links =
+    (compact
+      ? graph.compactLinks
+      : graph.links) || [];
+
+  container.classList.toggle("is-compact", compact);
+  container.dataset.compact = String(compact);
+
+  const byId = new Map(nodes.map((node) => [node.id, node]));
+  const maxCount = Math.max(...nodes.map((node) => Number(node.count) || 0));
+  const maxWeight = Math.max(1, ...links.map((link) => Number(link.weight) || 0));
+  const neighbours = new Map(nodes.map((node) => [node.id, new Set([node.id])]));
+
+  const svg = createSvgElement("svg", {
+    viewBox: "0 0 " + width + " " + height,
+    preserveAspectRatio: "xMidYMid meet",
+    role: "img",
+  });
+
+  const title = createSvgElement("title", {});
+  title.textContent =
+    document.documentElement.lang === "en"
+      ? "Research keyword map of the lab's publications"
+      : "연구실 출판물에서 추출한 연구 키워드 지도";
+  svg.append(title);
+
+  const linkLayer = createSvgElement("g", { class: "keyword-links" });
+  const nodeLayer = createSvgElement("g", { class: "keyword-nodes" });
+
+  links.forEach((link) => {
+    const source = byId.get(link.source);
+    const target = byId.get(link.target);
+    if (!source || !target) {
+      return;
+    }
+
+    neighbours.get(source.id).add(target.id);
+    neighbours.get(target.id).add(source.id);
+
+    const line = createSvgElement("line", {
+      x1: source.x,
+      y1: source.y,
+      x2: target.x,
+      y2: target.y,
+      "stroke-width": (
+        0.7 + 1.5 * ((Number(link.weight) || 1) / maxWeight)
+      ).toFixed(2),
+    });
+    line.dataset.source = source.id;
+    line.dataset.target = target.id;
+    linkLayer.append(line);
+  });
+
+  nodes.forEach((node) => {
+    const group = createSvgElement("g", { class: "keyword-node", tabindex: "0" });
+    group.dataset.id = node.id;
+
+    const onRight = node.x > width * 0.58;
+    const labelX = onRight ? node.x - node.r - 6 : node.x + node.r + 6;
+
+    const circle = createSvgElement("circle", {
+      cx: node.x,
+      cy: node.y,
+      r: node.r,
+      fill: keywordRampColor(Number(node.count) || 0, maxCount),
+    });
+
+    const label = createSvgElement("text", {
+      x: labelX,
+      y: node.y,
+      "text-anchor": onRight ? "end" : "start",
+      "dominant-baseline": "middle",
+    });
+    label.textContent = node.label || node.id;
+
+    const caption = createSvgElement("title", {});
+    caption.textContent =
+      (node.label || node.id) + " · " + (node.count || 0);
+    group.append(caption, circle, label);
+    nodeLayer.append(group);
+  });
+
+  svg.append(linkLayer, nodeLayer);
+
+  const setActive = (id) => {
+    svg.classList.toggle("is-focused", Boolean(id));
+    const related = id ? neighbours.get(id) : null;
+
+    nodeLayer.querySelectorAll(".keyword-node").forEach((element) => {
+      element.classList.toggle(
+        "is-dimmed",
+        Boolean(related) && !related.has(element.dataset.id)
+      );
+      element.classList.toggle("is-active", element.dataset.id === id);
+    });
+
+    linkLayer.querySelectorAll("line").forEach((line) => {
+      line.classList.toggle(
+        "is-active",
+        Boolean(id) &&
+          (line.dataset.source === id || line.dataset.target === id)
+      );
+    });
+  };
+
+  nodeLayer.querySelectorAll(".keyword-node").forEach((element) => {
+    element.addEventListener("mouseenter", () => setActive(element.dataset.id));
+    element.addEventListener("focus", () => setActive(element.dataset.id));
+    element.addEventListener("mouseleave", () => setActive(null));
+    element.addEventListener("blur", () => setActive(null));
+  });
+
+  container.querySelector("svg")?.remove();
+  container.prepend(svg);
+  container.classList.add("is-ready");
+}
+
+async function initializeKeywordGraph() {
+  const container = document.getElementById("keyword-graph");
+  if (!container) {
+    return;
+  }
+
+  try {
+    const response = await fetch(container.dataset.source, { cache: "no-cache" });
+    if (!response.ok) {
+      throw new Error("Keyword graph request failed: " + response.status);
+    }
+
+    const graph = await response.json();
+    renderKeywordGraph(container, graph);
+
+    let keywordResizeFrame = 0;
+    window.addEventListener("resize", () => {
+      window.cancelAnimationFrame(keywordResizeFrame);
+      keywordResizeFrame = window.requestAnimationFrame(() => {
+        const compact = container.clientWidth < KEYWORD_COMPACT_WIDTH;
+        if (String(compact) !== container.dataset.compact) {
+          renderKeywordGraph(container, graph);
+        }
+      });
+    });
+  } catch (error) {
+    container.remove();
+    console.error(error);
+  }
+}
+
 function initializePage() {
   initializeNavigation();
   initializeLanguageSwitcher();
   initializeSectionHighlighting();
   initializeImageSlots();
+  initializeKeywordGraph();
   initializeMembers();
   initializeProjects();
   initializeNews();
