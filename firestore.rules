rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboards/{difficulty}/scores/{scoreId} {
      allow read: if difficulty in ['easy', 'normal', 'hard'];

      allow create: if request.auth != null
        && difficulty in ['easy', 'normal', 'hard']
        && request.resource.data.keys().hasOnly([
          'nickname',
          'elapsedMs',
          'createdAt',
          'uid'
        ])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.elapsedMs is int
        && request.resource.data.elapsedMs >= 1000
        && request.resource.data.elapsedMs <= 86400000
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
